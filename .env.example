# Never expose the staging API origin to browser bundles. Browser requests use
# the same-origin /api/v1 rewrite; the Next.js server proxies through this URL.
API_BACKEND_URL=https://staging-api-gateway.example.com
NEXT_PUBLIC_SITE_URL=https://fin-web-preview.example.com


# Editorial data is fetched through fin-api. Directus credentials stay on the API.
